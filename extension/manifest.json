{
  "manifest_version": 3,
  "name": "FEDIT – 패션 상품 저장·분석",
  "short_name": "FEDIT",
  "version": "0.1.0",
  "description": "보고 있는 쇼핑몰 상품을 AI로 분석하고, 비슷한 상품을 찾고, FEDIT 내 보드에 저장합니다.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FEDIT 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://mify.kro.kr/*",
    "https://*.musinsa.com/*",
    "https://*.29cm.co.kr/*",
    "https://*.wconcept.co.kr/*",
    "https://*.zara.com/*",
    "https://*.cos.com/*",
    "https://*.hm.com/*",
    "https://*.uniqlo.com/*",
    "https://*.ssfshop.com/*",
    "https://*.lfmall.co.kr/*",
    "https://*.thehandsome.com/*",
    "https://*.kream.co.kr/*",
    "https://*.a-bly.com/*",
    "https://*.zigzag.kr/*",
    "https://*.mustit.co.kr/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://fedit.mify.im/*",
        "https://fedit.vercel.app/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "content/fedit-auth-sync.js"
      ],
      "run_at": "document_start"
    }
  ]
}
